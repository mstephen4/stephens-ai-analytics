# Local secrets — never commit real keys
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_LIFETIME_VARIANT_ID=

# Checkout links shown in the Olympic paywall modal
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_PRO=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_LIFETIME=
# Display labels from your Lemon Squeezy product (not enforced by code — set to match your store)
NEXT_PUBLIC_PRO_PRICE_LABEL=
NEXT_PUBLIC_LIFETIME_PRICE_LABEL=
# Optional: Lemon Squeezy customer portal for manage/cancel subscription
NEXT_PUBLIC_LEMONSQUEEZY_CUSTOMER_PORTAL=

# Auth + trial (BYOK-safe — gates Pro features only, not model access)
AUTH_SECRET=
TRIAL_DAYS=3
NEXT_PUBLIC_TRIAL_DAYS=3
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=AI Olympiad <onboarding@resend.dev>
LEMONSQUEEZY_WEBHOOK_SECRET=
